# __HOST__  ->  __UPSTREAM__   (certificate of __BASE__)
server {
    listen 443 ssl;
    http2 on;
    server_name __HOST__;
    ssl_certificate     /etc/nginx/certs/__BASE__/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/__BASE__/privkey.pem;
    include snippets/ssl.conf;
    location / {
        set $upstream http://__UPSTREAM__;
        proxy_pass $upstream;
        include snippets/proxy.conf;
    }
}
